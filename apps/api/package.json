{
  "name": "@momentum/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "migrate": "node --env-file-if-exists=../../.env src/migrate.ts",
    "create-owner": "node --env-file-if-exists=../../.env src/create-owner.ts"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.18",
    "@inquirer/prompts": "8.7.5",
    "better-auth": "1.7.18",
    "express": "^5.1.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.15.5",
    "typescript": "~6.0.3"
  }
}
